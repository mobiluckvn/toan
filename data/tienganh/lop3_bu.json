 "mau_cau": {
  "_vi_sao_doi_cong_thuc": [
   "26/42 công thức lớp 3 có dấu `/` — bản đồ để người soạn tự chọn một trong hai.",
   "Máy điền thẳng thì ra câu bé không đọc nổi: 'Hello. / Hi. I'm Ben.'",
   "",
   "Chia làm ba loại, xử ba cách:",
   "  · `a/an` → MÁY chọn được (nguyên âm thì 'an'), đã làm ở sinh_bai_tienganh.py",
   "  · `/` ở ĐẦU câu (Hello / Hi · Touch / Open · he / she) → NGƯỜI chọn, đè ở đây",
   "  · `/` ở lời ĐÁP (Yes, I do. / No, I don't.) → GIỮ, đó là cặp đáp mẫu hợp lệ,",
   "    và mọi chỗ bắt bé nói hay gõ đều chỉ lấy vế trước ' - '."
  ],
  "sp_g3_u1_1": {
   "cong_thuc": "Hello. I'm + [Name].",
   "vi_du": "Hello. I'm Ben."
  },
  "sp_g3_u1_2": {
   "cong_thuc": "Hello, + [Name A]. I'm + [Name B].",
   "vi_du": "Hello, Minh. I'm Lucy."
  },
  "sp_g3_u1_4": {
   "cong_thuc": "Goodbye.",
   "vi_du": "Goodbye."
  },
  "sp_g3_u3_1": {
   "cong_thuc": "This is + [Person].",
   "vi_du": "This is Ms Hoa."
  },
  "sp_g3_u3_2": {
   "cong_thuc": "Is this + [Person]? - Yes, it is. / No, it isn't."
  },
  "sp_g3_u4_2": {
   "cong_thuc": "Touch your + [Body part]!"
  },
  "sp_g3_u11_1": {
   "cong_thuc": "Who's this? - It's my + [Family member]."
  },
  "sp_g3_u11_2": {
   "cong_thuc": "How old is she? - She's + [Number] + years old."
  },
  "sp_g3_u12_1": {
   "cong_thuc": "What's her job? - She's + a/an + [Job]."
  },
  "sp_g3_u12_2": {
   "cong_thuc": "Is she + a/an + [Job]? - Yes, she is. / No, she isn't."
  },
  "sp_g3_u13_1": {
   "cong_thuc": "Where's the + [Room]? - It's here."
  },
  "sp_g3_u13_2": {
   "cong_thuc": "Where are the + [Furniture]? - They're + [Preposition] + the room."
  },
  "sp_g3_u14_1": {
   "cong_thuc": "There's a + [Things] + in the room."
  },
  "sp_g3_u14_2": {
   "cong_thuc": "The + [Thing] + is + [Adjective]."
  },
  "sp_g3_u15_2": {
   "cong_thuc": "What would you like to eat? - I'd like some + [Food / Drink], please."
  },
  "sp_g3_u17_1": {
   "cong_thuc": "She has + a/an + [Toy].",
   "vi_du": "She has a kite."
  },
  "sp_g3_u19_1": {
   "cong_thuc": "She's + [Outdoor activity].",
   "vi_du": "She's cycling."
  },
  "sp_g3_u19_2": {
   "cong_thuc": "What's she doing? - She's + [Outdoor activity]."
  },
  "sp_g3_u7_1": {
   "vi_du": "Come in, please!"
  },
  "sp_g3_u16_1": {
   "cong_thuc": "Do you have any + [Pets-plural]? - Yes, I do. / No, I don't."
  },
  "sp_g3_starter_1": {
   "_them_moi": "Sách không khai mẫu câu nào cho Starter, nên bài mất bậc 3 — bé học xong không ráp được câu nào. Câu này nằm TRỌN trong năng lực đã khai của Starter (“Đọc số từ một đến mười”) và trùng khuôn U13 lớp 2, để hai quyển nối được nhau.",
