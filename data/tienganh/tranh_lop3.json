   }
  ],
  "bienSo": {
   "so": 5,
   "x": 1110,
   "y": 170
  },
  "ke": [
   360,
   620
  ],
  "ten_en": "In the toy shop",
  "_sai_vi_sao": "Mồi nhử cho câu “Câu nào ĐÚNG với bức tranh?” phải là câu SAI với tranh này. Không suy được bằng máy: “There's a cat.” cũng đúng dù không nằm trong `moTa`. Nên khai tay những câu CHẮC CHẮN sai — vật ấy không có trong tranh, hoặc số ấy không khớp. Đoán ở đây là đẻ ra câu hỏi hai đáp án đúng.",
  "doan": [
   "This is a kite.",
   "I can see a ball.",
   "That's a yo-yo.",
   "There's a kitten.",
   "I can see a teddy bear."
  ],
  "_doan_vi_sao": "Bốn khuôn KHÁC NHAU cho năm câu (This is · I can see · That's · There's), đều là khuôn của sách — L1U04 · L1U14 · L1U10 · L1U07. Viết cả năm câu bằng một khuôn thì đoạn đọc lên như bảng cửu chương.\nMỗi câu ứng với ĐÚNG MỘT vật trong tranh, và tranh có đúng ngần ấy vật — không thừa, không thiếu. Đó là điều bác đòi: nội dung đồng bộ với tranh.",
  "hoiGoiY": [
   {
    "hoi": "What can you see?",
    "y": "bé kể ra một vật bất kỳ trong tranh"
   },
   {
    "hoi": "What number is it?",
    "dap": "It's five.",
    "y": "đọc số trên tấm biển"
   }
  ],
  "_hoiGoiY_vi_sao": "Bác chốt: “Câu hỏi dùng cho cô giáo gợi ý học sinh để tả thôi. Ví dụ học sinh không biết tả thì cô hỏi how many kite in the picture.” Nên mấy câu này KHÔNG xuất hiện ở màn đọc hay màn viết — chúng chỉ là công cụ của cô trong phòng nói, dùng khi bé bí.",
  "sai": [
   "I can see a dog.",
   "There's a garden.",
   "She's running.",
   "The cake is on the table."
  ],
  "hoiDoc": [
   {
    "loai": "yChinh",
    "en": "What can you see?",
    "vi": "Con nhìn thấy gì trong tranh?",
    "dap": "I can see a ball.",
    "moi": [
     "I can see a dog.",
     "There's a garden.",
     "She's running."
    ],
    "giai": "Trong tranh có quả bóng."
   },
   {
    "loai": "chiTiet",
    "en": "What number is it?",
    "vi": "Trên tấm biển là số mấy?",
    "dap": "It's five.",
    "moi": [
     "It's three.",
     "It's four.",
     "It's six."
    ],
    "giai": "Tấm biển ghi số 5."
   },
   {
    "loai": "chiTiet",
    "en": "How many kittens can you see?",
    "vi": "Con thấy mấy con mèo con?",
    "dap": "I can see one.",
    "moi": [
     "I can see two.",
     "I can see three.",
     "I can see four."
    ],
    "giai": "Trong tranh có một con mèo con."
   }
  ],
  "_hoiDoc_vi_sao": "Bác chốt 19-08: “phần câu hỏi và câu trả lời của bài đọc hãy dùng tiếng anh”.\n⚠ Ba câu hỏi này chỉ dùng KHUÔN ĐÃ HỌC tới unit 0: “What can you see?” (lớp 2 unit 4) · “What number is it?” (chính unit 0) · “How many … can you see? - I can see one.” (lớp 1 unit 16). Hỏi bằng một khuôn bé chưa gặp thì bài đọc hiểu hoá ra bài đoán đề.\n⚠ MẤT CÂU HỎI “bức tranh vẽ ở đâu”. Tới unit 0 sách chưa có khuôn nào hỏi bối cảnh bằng tiếng Anh (“Where is it?” chưa dạy), mà dịch bừa là bịa. Câu “What can you see?” gánh vai TỔNG QUAN thay nó — nó hỏi về cả bức tranh chứ không hỏi một góc.\nLời Việt vẫn còn, nhưng là dòng NHỎ dưới câu tiếng Anh: bé đọc được thì đọc tiếng Anh, chưa được thì có chỗ bám. Lựa chọn thì THUẦN tiếng Anh — đó mới là chỗ bé luyện đọc thật."
 },
