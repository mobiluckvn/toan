node_modules/
dist/
.env.local

# Môi trường Python của dây chuyền TTS (Kokoro) — ~1 GB, cài lại bằng
# tools/tts/cai_dat.sh chứ không commit. Xem tools/tts/README.md.
tools/tts/.venv/
tools/tts/model/
tools/tts/Kokoro-Vietnamese/
tools/tts/ra/
.firebase/
__pycache__/
*.pyc
firebase-debug.log
dat-bi-mat.sh
.DS_Store

# bí mật của bộ giả lập — không bao giờ commit.
# Che theo MẪU chứ không theo từng tên tệp: thêm một bí mật mới mà quên khai ở đây
# thì nó lọt vào git, và khoá đã lên git thì coi như đã lộ — có xoá commit cũng
# phải đi thu hồi khoá. Tệp mẫu `.secret.local.mau` thì KHÔNG chứa khoá, vẫn commit.
web/functions/.secret.local
web/functions/.env
web/functions/.env.*
!web/functions/.secret.local.mau
.env
firestore-debug.log
ui-debug.log

# ── KHOÁ QUẢN TRỊ — TUYỆT ĐỐI KHÔNG COMMIT ──────────────────────────────────
# Khoá dịch vụ mở được TOÀN BỘ dữ liệu dự án: học bạ, bài viết, tài khoản.
# Lọt lên GitHub thì đổi khoá cũng không lấy lại được cái đã lộ.
# ⚠ Kho này hay được commit bằng `git add -A`, nên chặn ở đây là chặn duy nhất.
khoa-dich-vu.json
*-khoa-dich-vu.json
serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json

# Bản sao lưu dữ liệu học THẬT của trẻ — không đưa lên git
sao_luu_don_ban_ghi*.json

# Tệp khoá tạm Word đẻ ra khi đang mở .docx — không phải nội dung
~$*

# Đầu ra của xưởng sinh nội dung (tools/xuong) — bản NHÁP do mô hình soạn,
# chưa qua người duyệt. Không đưa vào kho: nó là thứ sinh lại được, và một bản
# nháp nằm trong git là một bản nháp sớm muộn có người tưởng là nội dung thật.
data/tienganh/xuong/

# Hàng đợi duyệt câu kéo về từ `choDuyetTA` (tools/nhap_cau_duyet.py --lay).
# Trong đó có `learnerId` của bé có thật và câu mô hình soạn CHƯA ai duyệt — hai thứ
# đều không nên nằm trong git. Câu đã duyệt thì ở `data/tienganh/cau_duyet.json`.
data/tienganh/cho_duyet/

# Dữ liệu mô phỏng sinh ra (tái tạo được bằng --hat)
web/tools/mo_phong/ra/
