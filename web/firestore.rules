rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ══════════════════════════════════════════════════════════════════════
       BA VAI TRÒ — MỘT TÀI KHOẢN LÀ MỘT HỌC SINH
         · learner  phụ huynh và con dùng chung một tài khoản. Đọc/ghi dữ liệu
                    của chính mình, không thấy ai khác.
         · teacher  đọc kết quả của TOÀN BỘ học sinh. Không ghi được gì vào bài làm.
         · admin    toàn quyền.

       Vai trò đọc từ CUSTOM CLAIM trong token, do Cloud Function đặt lúc đăng nhập —
       không đọc từ Firestore. Hai lý do: khỏi tốn một lượt đọc cho MỖI lần kiểm quyền,
       và quan trọng hơn: người dùng ghi được vào users/{uid} của mình, nên nếu tin
       vào trường role trong đó thì ai cũng tự phong mình làm giáo viên được.
       ══════════════════════════════════════════════════════════════════════ */

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }
    function role()     { return request.auth.token.role; }

    function isTeacher() { return signedIn() && role() == 'teacher'; }
    function isAdmin()   { return signedIn() && role() == 'admin'; }
    /* VAI TRÒ THỨ TƯ — chuyên gia chương trình (R7, mục 3.8.4). Bác chốt 10-10-2026
       là tách hẳn khỏi `admin`: người hiểu việc DẠY HỌC quyết định ngưỡng, không
       phải người quản trị hệ thống. Và tách ra thì admin không vô tình sửa được. */
    function isChuyenGia() { return signedIn() && role() == 'chuyengia'; }
    function isMine(id)  { return signedIn() && id == uid(); }

    /* Ai được XEM kết quả học của một tài khoản: chính chủ, giáo viên, admin */
    function canRead(id) { return isMine(id) || isTeacher() || isAdmin(); }


    /* ── Hồ sơ người dùng ── */
    match /users/{userId} {
      allow read: if canRead(userId);

      /* Chính chủ sửa được tên và lớp, nhưng KHÔNG đụng được vào role.
         Đây là chốt chặn quan trọng nhất của cả bộ luật: mất nó thì bất kỳ ai
         cũng ghi role='teacher' vào hồ sơ mình rồi đọc kết quả cả trường. */
      allow update: if isMine(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    /* Cờ mô phỏng do quản trị đặt (tools/mo_phong). Mở cho chính chủ
                       thì một em thật tự giấu mình khỏi bảng cô giáo được. */
                    && request.resource.data.get('moPhong', false) == resource.data.get('moPhong', false);

      /* Tạo hồ sơ là việc của Cloud Function lúc đăng nhập (Admin SDK bỏ qua luật này).
         Không mở cho máy con, nếu không người ta tự tạo hồ sơ kèm role tuỳ ý. */
      allow create, delete: if isAdmin();
    }

    /* ── Mã OTP: KHÔNG AI đụng tới, kể cả admin ──
       Chỉ Cloud Function qua Admin SDK. Mở dù chỉ quyền đọc là lộ bản băm,
       mở quyền ghi là tự đặt mã cho tài khoản người khác. */
    match /otpCodes/{email} {
      allow read, write: if false;
    }

    /* ── NHẬT KÝ TRẢ LỜI — bằng chứng học tập, BẤT BIẾN với tất cả ── */
    match /attempts/{attemptId} {
      allow read: if canRead(resource.data.learnerId);

      allow create: if isMine(request.resource.data.learnerId)
                    && request.resource.data.keys().hasAll(
                         ['learnerId','microId','itemId','phase','correct','ts'])
                    && request.resource.data.correct is bool
                    && request.resource.data.phase in ['practice','assess','check','worked']
                    /* mốc máy chủ do Firestore đóng dấu, không nhận giờ tự khai */
                    && (!request.resource.data.keys().hasAny(['serverTs'])
                        || request.resource.data.serverTs == request.time);

      allow update, delete: if false;   // không ai sửa được điểm đã ghi, kể cả admin
    }

    /* ── Mức thạo (BKT): chỉ Cloud Function ghi ── */
    match /mastery/{userId}/units/{unitId} {
      allow read:  if canRead(userId);
      allow write: if false;
    }

    /* ── Tiến độ từng bài ── */
    match /progress/{userId}/micros/{microId} {
      allow read: if canRead(userId);
      allow write: if isMine(userId)
                   && request.resource.data.pass is bool
                   && request.resource.data.score is number;
    }

    /* ── HỌC BẠ — kỳ sát hạch chương, bậc chủ đề đã vững, vòng đấu Mùa giải ──

       Ba thứ này trước nay chỉ nằm ở localStorage: đổi máy là mất, và cô giáo
       không bao giờ thấy được con vững CHỦ ĐỀ nào (chỉ thấy con xong BÀI nào).

       Để riêng chứ không nhét vào progress/{uid}/micros: hàm nền `onMicroDone`
       chạy trên mọi tài liệu của thư mục ấy và đọc thẳng `after.microId`.

       `loai` bắt buộc và phải nằm trong ba giá trị đã biết — chốt chặn để máy con
       không dựng ra một hình dạng thứ tư mà sổ phụ huynh không đọc được. */
    match /hocBa/{userId}/muc/{mucId} {
      allow read:  if canRead(userId);
      /* `gio` THÊM 17-08-2026 — sổ giờ học theo ngày (xem src/mon/toan/lib/dongHo.js).
         ⚠ Danh sách này là chỗ đã từng nuốt dữ liệu trong im lặng: `loai` không có tên
         ở đây thì Firestore từ chối mà KHÔNG báo gì, sổ tại máy vẫn đúng nên không ai
         thấy. Thêm `loai` mới ở máy con là phải thêm vào đây VÀ deploy rules. */
      allow write: if isMine(userId)
                   && request.resource.data.loai in ['chuong', 'chuDe', 'dau', 'gio'];
    }

    /* ══ MÔN TIẾNG ANH — collection RIÊNG ══

       Không dùng chung `progress/{uid}/micros` với Toán, và lý do không phải là sợ
       trùng mã bài. Lý do thật: hàm nền chạy trên MỌI tài liệu của thư mục ấy rồi
       tính mức thạo theo ma trận của Toán. Đổ bài tiếng Anh vào đó là hàm nền âm
       thầm tính sai cho cả hai môn.

       ⚠ Hai khối dưới đây phải được DEPLOY thì máy con mới ghi được. Chưa deploy
       thì `match /{document=**}` ở cuối tệp chặn, và Firestore từ chối TRONG IM
       LẶNG với lệnh ghi không chờ kết quả: bé học xong, máy báo xong, máy chủ
       trống. Đã dính một lần khi làm học bạ.

           firebase deploy --only firestore:rules                              */

    match /progressTA/{userId}/micros/{microId} {
      allow read: if canRead(userId);
      /* Cùng hai chốt kiểu dữ liệu như `progress` của Toán: thiếu hoặc sai kiểu
         một trong hai trường này là bị từ chối. Giữ giống nhau để người sửa một
         bên không phải đoán bên kia.

         XOÁ CŨNG BỊ CHẶN, và đó là điều ĐÚNG — nhưng ban đầu là ngẫu nhiên: lệnh
         xoá không mang `request.resource.data` nên hai điều kiện trên tự nhiên
         sai. Thử trên bộ giả lập mới lộ ra. Ghi lại thành chủ ý: bài đã học là
         bằng chứng học tập, không ai xoá được — kể cả chính chủ. Muốn cho xoá thì
         phải viết `allow delete` riêng, chứ đừng nới hai dòng trên. */
      allow write: if isMine(userId)
                   && request.resource.data.pass is bool
                   && request.resource.data.score is number;
    }


    /* Trạng thái điểm chỉ có HAI giá trị (việc V5, `TRANG_THAI_DIEM`). Chốt ở luật
       chứ không chỉ ở máy con: một giá trị thứ ba lọt vào sổ thì `diemHienThi` coi
       nó là `tam` — an toàn, nhưng sổ mang một hình dạng không ai khai.
       ⚠ PHẢI CHO MỤC CŨ ĐI QUA. Mục `viet` ghi trước V5 không có trường này, và bé
       viết lại một bài cũ là ghi lại đúng mục ấy. Đòi trường luôn có thì mọi bài
       viết cũ hoá thành không ghi lại được — im lặng. */
    function trangThaiDiemHopLe(du) {
      /* ⚠ `du.giaTri.trangThai` TRÊN MỤC CŨ LÀ MỘT LỖI, KHÔNG PHẢI `null`.
         Đọc một khoá không có trong map thì rules NÉM LỖI, và lỗi làm cả điều kiện
         thành `false` — tức TỪ CHỐI. Nên mọi bài viết cũ hoá thành không ghi lại
         được, im lặng. Phép `!('trangThai' in …) ||` cũng không cứu được vì nhánh
         sau vẫn bị phân tích. Dùng `get` có mặc định: đúng một cách an toàn. */
      return du.loai != 'viet'
             || du.giaTri.get('trangThai', 'tam') in ['tam', 'xacNhan'];
    }
    match /hocBaTA/{userId}/muc/{mucId} {
      allow read:  if canRead(userId);
      /* Ba loại, và danh sách vẫn hẹp là cố ý — máy con không dựng được một hình
         dạng thứ tư mà sổ phụ huynh không đọc nổi.
           chuong   kỳ ôn tập chương
           viet     bài viết ngắn, ĐIỂM DO AI CHẤM (bác chốt 18-08-2026)
           doc      bài đọc hiểu (bác chốt 23-08-2026 — trước đó CỐ Ý chỉ giữ tại
                    máy; nay phần đọc phải lên máy chủ và vào engine như phần viết)
           phien    một lần MỞ BÀI RỒI RỜI ĐI KHI CHƯA XONG — chặng nào, mấy lượt,
                    bao nhiêu giây. Chiều Thời gian của mục 2.1.2 đòi đo mệt mỏi
                    nhận thức, mà `attempts` chỉ thấy câu bé CÓ trả lời; bé mở bài
                    rồi tắt thì không dấu vết nào. ⚠ Chỉ bắt được lúc rời màn tử
                    tế — đóng thẳng tab thì không kịp ghi, nên đây là CẬN DƯỚI
           soThich  từ bé thích nhất trong quyển — cô giáo máy lấy làm ngữ cảnh
           hoSo     bé làm tốt dạng câu nào (chiều Sư phạm, mục 2.1.2-P)
           hoSoAI   TRÍ NHỚ của cô giáo máy về bé, giữ qua nhiều buổi (việc V3,
                    `lib/hosoai.js`). MỘT mục cho cả môn. ⚠ Chỉ dữ liệu HỌC: không
                    một chữ nào bé tự nói ra, không nhận xét về bé, không điểm —
                    luật ghi ở đầu `hosoai.js`, và bố mẹ xoá sạch được bất cứ lúc
                    nào từ Góc bố mẹ
           phudao   KHUNG một lần can thiệp phụ đạo (giao thức A-R-A, mục 3.6.3):
                    nút mắc · nút gốc rễ · câu đã hỏi TRƯỚC · câu của bài phụ đạo ·
                    hai mốc thời gian. ⚠ KHÔNG chứa mức tinh thông trước/sau — máy
                    con chỉ có bản `mastery` nạp lúc mở bài, mà hàm nền cập nhật sau
                    một quãng trễ, nên con số ấy là con số CŨ và ghi vào thì ΔC sai
                    theo hướng không ai lần ra. Hai lần đo dựng lại được từ chính
                    `attempts` — thứ gì suy được từ nhật ký thì đừng chép thêm bản

         ⚠ `viet` chứa CHÍNH BÀI BÉ VIẾT và lời chấm — bố mẹ phải đọc được (bác
         chốt), nên vẫn nằm trong học bạ mà `canRead` cho cả giáo viên xem, đúng như
         mọi kết quả học khác. Khác hẳn `phongNoiTA`: chỗ ấy là tiếng nói riêng tư
         của bé nên chỉ chính chủ đọc được.

         ⚠ `soThich` NẰM ĐÚNG CHỖ NÀY chứ không phải `phongNoiTA`, và đó là chủ ý:
         nó chỉ chứa MỘT TỪ LẤY TỪ CHÍNH BÀI HỌC ('dolphin', 'football') — cùng
         hạng với điểm số, không phải lời bé tự nói ra. Nếu sau này có ai muốn giữ
         thêm thứ bé tự kể về mình thì thứ ấy thuộc `phongNoiTA`, đừng đắp vào đây.

         ⚠ THÊM MỘT LOẠI Ở ĐÂY LÀ PHẢI SỬA BỐN CHỖ, không phải một: luật này ·
         `duLieu.js` bên đọc · chỗ gọi `luuMucHocBa` ở `ManTiengAnh.jsx` · và phải
         `deploy --only firestore:rules` TRƯỚC khi bản mới lên. Thiếu bước deploy
         thì Firestore từ chối TRONG IM LẶNG. Cổng `hocba_khop_luat.test.mjs` soi
         ba chỗ đầu; bước deploy thì không cổng nào canh được. */
      /* ⚠ DANH SÁCH NÀY LÀ NGUỒN DUY NHẤT, và cổng `hocba_khop_luat.test.mjs` đọc
         thẳng từ đây chứ không chép sang. Đừng gói nó vào một hàm `function` của
         rules: cổng tìm danh sách NGAY TRONG khối `match`, và gói đi là nó không
         tìm được nữa — tôi vừa thử và nó đỏ. */
      allow create, delete: if isMine(userId)
                            && request.resource.data.loai in ['chuong', 'viet', 'doc',
                                                              'phien', 'soThich',
                                                              'hoSo', 'hoSoAI',
                                                              'phudao']
                            && trangThaiDiemHopLe(request.resource.data);

      /* ── BỐ MẸ XÁC NHẬN ĐIỂM MÁY CHẤM (việc V5) ──
         Điểm bài viết do mô hình chấm, nên nó là ĐIỂM TẠM cho tới khi người lớn
         xem. Bố mẹ đồng ý hoặc sửa — và đó là lệnh UPDATE, khác hẳn lệnh ghi mới.

         ⚠ CHỈ BA TRƯỜNG. `affectedKeys().hasOnly` là chốt thật, không phải lời dặn:
         không có nó thì một lệnh "xác nhận điểm" sửa được luôn `cham` và `viet` —
         tức sửa được LỜI CHẤM và BÀI BÉ VIẾT. Hai thứ ấy là bằng chứng: bố mẹ phải
         đọc được máy chấm đã nói gì để biết nó đúng hay sai, mà sửa được thì câu
         "máy chấm có hay sai không" hết đường trả lời.

         Và máy chủ không tin máy con ở chỗ này: luật phải tự chặn, vì mã máy con
         thì ai cũng đọc và sửa được.

         ⚠ `giaTri` là một map, nên `affectedKeys()` ở tầng ngoài chỉ thấy đúng
         `giaTri` đổi. Phải soi vào TRONG nó. */
      /* ⚠ GHI LẠI MỘT MỤC ĐÃ CÓ LÀ CHUYỆN THƯỜNG, ĐỪNG CHẶN.
         `luuMucHocBa` dùng `setDoc(..., {merge:true})`, nên ghi lần hai cùng một
         bài là lệnh UPDATE. Bé làm lại kỳ ôn tập, bỏ dở bài lần thứ hai, viết lại
         bài viết — tất cả đều ghi lại. Bản đầu của luật này chỉ cho update khi
         `loai == 'viet'` và đúng ba trường đổi, nên MỌI lần ghi lại của MỌI loại
         khác bị từ chối — và từ chối trong im lặng, vì `luuMucHocBa` không chờ kết
         quả. Cổng `luat_firestore` lần chạy ĐẦU vẫn xanh (kho trống nên mọi lệnh là
         `create`); chỉ lần chạy THỨ HAI mới lộ.

         Nên chốt đúng một điều, và là điều V5 cần: KHÔNG được vừa đánh dấu "bố mẹ
         đã xác nhận" vừa sửa lời chấm trong cùng một lệnh. Ngoài ca ấy thì update
         như cũ.

         `loai` KHÔNG đổi được khi update — nhờ thế khỏi phải nhắc lại danh sách
         loại ở đây, và danh sách vẫn chỉ có MỘT bản (luật `create` trên).

         ⚠ NÓI THẲNG GIỚI HẠN: luật này không ngăn được chính chủ ghi một mục `tam`
         với lời chấm tự bịa rồi xác nhận nó. Không ngăn được, và trước V5 cũng thế —
         học bạ là sổ của chính bé. Bằng chứng bất biến là `attempts`, chỗ không ai
         sửa được kể cả admin. Điều V5 thêm được: một điểm ĐÃ XÁC NHẬN thì không thể
         bị sửa lời chấm trong cùng cái lệnh xác nhận ấy. */
      allow update: if isMine(userId)
                    && request.resource.data.loai == resource.data.loai
                    && trangThaiDiemHopLe(request.resource.data)
                    && (resource.data.loai != 'viet'
                        || request.resource.data.giaTri.get('trangThai', 'tam') != 'xacNhan'
                        || request.resource.data.giaTri.diff(resource.data.giaTri)
                             .affectedKeys()
                             .hasOnly(['trangThai', 'diemNguoi', 'xacNhanLuc']));
    }

    /* ── PHÒNG LUYỆN NÓI: buổi nói chuyện của bé với cô giáo máy ──
       Máy chủ KHÔNG lưu gì (bác chốt) — chính máy con đẩy buổi lên đây. Nên luật
       phải cho chính chủ GHI, chứ không như `report` chỉ Function mới được ghi.

       ⚠ Đây là TIẾNG NÓI của trẻ con, thứ riêng tư nhất trong cả kho. `canRead`
       cho cả giáo viên đọc — đúng với kết quả học, nhưng một buổi trò chuyện thì
       khác hẳn. Nên ở đây chỉ CHÍNH CHỦ và admin, cô giáo KHÔNG đọc được. Muốn đổi
       thì phải là quyết định có người chịu trách nhiệm, đừng nới cho tiện. */
    match /phongNoiTA/{userId}/buoi/{buoiId} {
      allow read:  if isMine(userId) || isAdmin();
      /* Hai chốt kiểu dữ liệu, cùng lối với `progressTA`: thiếu hoặc sai kiểu là
         từ chối. `soLuot` là số, `luot` là danh sách — sai hình dạng thì sổ bố mẹ
         mở ra vỡ, mà lúc ấy chẳng còn gì để lần. */
      allow write: if isMine(userId)
                   && request.resource.data.soLuot is int
                   && request.resource.data.luot is list;
    }

    /* ══ CÂU DO MÔ HÌNH SOẠN — CHỜ NGƯỜI LỚN DUYỆT (việc V9) ══

       Phụ đạo lấy câu từ kho TĨNH trước (hai vòng). Hết câu tĩnh thì nhờ mô hình
       soạn — và câu ấy là câu DUY NHẤT trong app không đi qua bộ sinh và 83 cổng.
       Máy con đã hậu kiểm từng câu bằng `cauHoiHopLe` (vốn từ của bài), nhưng hậu
       kiểm chỉ biết "câu này dùng chữ bé đã học"; nó không biết câu ấy có DẠY ĐÚNG
       không. Nên câu phải nằm ở đây chờ người lớn xem, rồi mới được ghép vào kho
       tĩnh bằng một bước thủ công.

       ⚠ BÉ GHI ĐƯỢC NHƯNG KHÔNG ĐỌC ĐƯỢC. Đây là hàng đợi DUYỆT, không phải sổ của
       bé: để bé đọc thì nó thành một kho câu chưa ai kiểm mà bé lấy ra làm được.
       Và `allow update` để người lớn đánh dấu đã duyệt — bé không có đường ấy.

       ⚠ `maNut` là một mã nút, có thể mang dấu `:` và `.` — đường dẫn phải là tài
       liệu PHẲNG dưới một collection, không phải `choDuyetTA/{maNut}/cau/{id}`:
       Firestore cấm `/` trong mã tài liệu và mã nút của Toán có chứa nó. */
    match /choDuyetTA/{cauId} {
      allow read:   if isTeacher() || isAdmin();
      allow create: if isMine(request.resource.data.learnerId)
                    && request.resource.data.nguon == 'ai'
                    && request.resource.data.maNut is string
                    && request.resource.data.trangThai == 'cho';
      /* ⚠ BÉ PHẢI GHI LẠI ĐƯỢC KHI CÂU CHƯA AI DUYỆT.
         Mã tài liệu là `{uid}__{mã câu}`, mà mã câu dựng tiền định từ mã nút
         (`pd_ai_<nút>_1`). Nên bé làm lại phụ đạo ở CÙNG nút là một lệnh UPDATE,
         không phải CREATE — và luật chỉ-cho-cô-giáo-update sẽ từ chối TRONG IM
         LẶNG (`luuCauChoDuyet` không chờ kết quả): câu mới của buổi sau không bao
         giờ lên tới hàng đợi.
         Cổng `luat_firestore` lần chạy ĐẦU vẫn xanh (kho trống nên mọi lệnh là
         `create`); chỉ lần chạy THỨ HAI mới lộ — đúng cùng chỗ đã dính ở việc V5.

         Nên: bé ghi lại được KHI câu còn `cho`, và chỉ được giữ nó ở `cho`. Ai đã
         duyệt rồi thì chỉ người lớn đụng được — không thì bé ghi đè một câu cô vừa
         bỏ, rồi nó quay lại hàng đợi như mới. */
      allow update: if ((isTeacher() || isAdmin())
                        && request.resource.data.trangThai in ['cho', 'duyet', 'bo'])
                    || (isMine(resource.data.learnerId)
                        && resource.data.trangThai == 'cho'
                        && request.resource.data.trangThai == 'cho'
                        && request.resource.data.learnerId == resource.data.learnerId
                        && request.resource.data.nguon == 'ai');
      allow delete: if isAdmin();
    }

    /* ── Hàng đợi ôn tập: việc riêng của từng bạn, cô không cần ── */
    match /reviewQueue/{userId}/cards/{cardId} {
      allow read:  if isMine(userId) || isAdmin();
      allow write: if isMine(userId);
    }

    /* ── Sổ học: Function dựng mỗi đêm ── */
    match /report/{userId} {
      allow read:  if canRead(userId);
      allow write: if false;
    }

    /* ── Bảng giáo viên: một document cho toàn hệ thống ── */
    match /teacherBoard/{doc} {
      allow read:  if isTeacher() || isAdmin();
      allow write: if false;
    }

    /* ── BẢNG XẾP HẠNG — tài liệu DUY NHẤT một bé đọc được về bé khác ──

       Cả bộ luật này dựng trên một nguyên tắc: mỗi bé chỉ đọc dữ liệu của mình.
       Chỗ này phá nguyên tắc ấy CÓ CHỦ Ý, để các con nhìn thấy nhau mà cố gắng.

       Vì thế nó là chỗ cẩn thận nhất: Function dựng tài liệu và CHỈ đặt vào đó biệt
       danh · lớp · sao. Không email, không số bài sai, không "em đang tắc ở bài nào".
       `allow write: if false` là chốt chặn — máy con không bao giờ tự ghi được vào
       bảng, nên không ai tự đặt điểm cho mình hay sửa tên bạn khác. */
    match /bangXepHang/{doc} {
      allow read:  if signedIn();
      allow write: if false;
    }

    /* ── Chỉ mục nội dung: ai đăng nhập cũng đọc, chỉ Admin SDK ghi ── */
    match /contentIndex/{microDoc} {
      allow read:  if signedIn();
      allow write: if false;
    }

    /* ══════════════════════════════════════════════════════════════════════
       BỐN BẢNG QUẢN LÝ NGƯỠNG — R7, Bảng 3.20 của luận văn.

       Nguyên tắc: GIÁ TRỊ MÁY HỌC RA CHỈ LÀ ĐỀ XUẤT; chỉ chuyên gia phát hành được
       một phiên bản. Luật dưới đây là chỗ biến nguyên tắc ấy thành hàng rào máy gác
       chứ không phải một lời hứa trong tài liệu.

       ⚠ AI ĐỌC ĐƯỢC. Ngưỡng là thứ máy con PHẢI đọc để chạy, nên `nguong` cho mọi
       tài khoản đã đăng nhập đọc. Ba bảng kia là việc của người lớn: lịch sử, đề
       xuất và thống kê chỉ chuyên gia với admin xem.
       ══════════════════════════════════════════════════════════════════════ */

    /* ── BỘ ĐẾM PHIÊN BẢN (Bảng 4.7, điểm 3) ──
       Một tài liệu `hienHanh`, một trường `so`. Hàm phát hành đọc nó TRONG giao dịch
       rồi ghi `so + 1`; luật chỉ cho TĂNG ĐÚNG MỘT, nên hai lần phát hành song song
       không thể ra cùng một số — lần sau bị từ chối, giao dịch chạy lại và lấy số kế
       tiếp. Mọi dòng `nguong`/`nguong_lich_su` phải mang đúng số mà bộ đếm có SAU
       lần ghi (`getAfter`), tức là phải được ghi CÙNG giao dịch với lần tăng ấy. */
    /* `getAfter` một mình KHÔNG đủ: ghi lẻ một dòng mà không đụng bộ đếm thì trạng
       thái "sau" vẫn là bộ đếm cũ, và dòng mang số cũ lọt qua — tức là ghi đè một
       phiên bản đã phát hành mà không tạo phiên bản mới. Nên còn đòi bộ đếm phải
       TĂNG ĐÚNG MỘT trong chính lần ghi này (hoặc vừa được tạo). */
    function soPhienBanSau() {
      return getAfter(/databases/$(database)/documents/nguong_phien_ban/hienHanh).data.so;
    }
    function phienBanVuaTang() {
      return !exists(/databases/$(database)/documents/nguong_phien_ban/hienHanh)
        || get(/databases/$(database)/documents/nguong_phien_ban/hienHanh).data.so + 1
           == soPhienBanSau();
    }
    match /nguong_phien_ban/{demId} {
      allow read:   if isChuyenGia() || isAdmin();
      allow create: if isChuyenGia() && demId == 'hienHanh'
                    && request.resource.data.so is int && request.resource.data.so >= 1;
      allow update: if isChuyenGia()
                    && request.resource.data.so == resource.data.so + 1;
      allow delete: if false;
    }

    /* PHẠM VI CỦA MỘT DÒNG NGƯỠNG (Bảng 4.7, điểm 2) — và mã tài liệu phải khớp nó.
       Toàn hệ: mã tài liệu là mã ngưỡng (`NG07`). Phạm vi hẹp: `NG07__khoiLop__3`, với
       `loai` là một nấc CÓ TRÊN THANG và `khoa` là chuỗi không rỗng. Khớp mã tài liệu
       với nội dung là để không thể có HAI dòng cùng nói về một ô (NG07 · khối lớp 3) —
       khi ấy máy đọc lấy dòng nào là tuỳ thứ tự, tức tuỳ may. */
    function phamViHopLe(d, id) {
      return !('phamVi' in d) || d.phamVi.loai == 'toanHe'
        ? id == d.ma
        : (d.phamVi.loai in ['nut', 'dangCau', 'bac', 'loaiNut', 'khoiLop', 'mon']
           && d.phamVi.khoa is string && d.phamVi.khoa.size() > 0
           && id == d.ma + '__' + d.phamVi.loai + '__' + d.phamVi.khoa);
    }

    /* ── Giá trị hiện hành. CHỈ chuyên gia ghi, và phải trong khoảng hợp lệ ── */
    match /nguong/{nguongId} {
      allow read: if signedIn();
      /* `canDuoi`/`canTren` là GIỚI HẠN CỨNG (mục 3.8.1) — chuyên gia hay thuật toán
         đều không ra ngoài được. Soi ngay tại tầng cơ sở dữ liệu, vì một màn hình
         quên soi thì vẫn còn chốt này; mà chốt ở màn hình thì ai gọi thẳng API là
         qua được. Ràng buộc GIỮA các ngưỡng (θ_yếu ≤ θ − 0,20) luật không so được —
         nó cần đọc tài liệu khác — nên nằm ở `soiNguong` và ở hàm phát hành. */
      allow write: if isChuyenGia()
                   && request.resource.data.keys().hasAll(
                        ['ma', 'giaTri', 'canDuoi', 'canTren', 'phienBan'])
                   && request.resource.data.phienBan is int
                   && request.resource.data.phienBan == soPhienBanSau()
                   && phienBanVuaTang()
                   && phamViHopLe(request.resource.data, nguongId)
                   && (request.resource.data.giaTri is number
                       ? (request.resource.data.giaTri >= request.resource.data.canDuoi
                          && request.resource.data.giaTri <= request.resource.data.canTren)
                       : request.resource.data.giaTri is map);
    }

    /* ── Lịch sử: CHỈ THÊM. Không sửa, không xoá, kể cả admin ──
       Cùng lẽ với `attempts`: một bản ghi về việc "ai đổi ngưỡng gì, lúc nào, vì
       sao" mà xoá được thì nó không còn là bằng chứng nữa. */
    match /nguong_lich_su/{banGhiId} {
      allow read:   if isChuyenGia() || isAdmin();
      allow create: if isChuyenGia()
                    && request.resource.data.keys().hasAll(
                         ['ma', 'giaTriMoi', 'phienBan', 'nguoiSua', 'thoiDiem', 'lyDo'])
                    && request.resource.data.nguoiSua == uid()
                    && request.resource.data.phienBan == soPhienBanSau()
                    && phienBanVuaTang()
                    && request.resource.data.lyDo is string
                    && request.resource.data.lyDo.size() > 0;
      allow update, delete: if false;
    }

    /* ── Đề xuất do hàm nền học ra. Máy con KHÔNG ghi được ──
       Chuyên gia chỉ đổi được `trangThai` (duyệt / từ chối) — không sửa được con số
       máy đã học, nếu không thì "đề xuất" thành chỗ nhập tay và mọi con số kèm theo
       (cỡ mẫu, khoảng tin cậy) nói về một giá trị khác. */
    match /nguong_de_xuat/{deXuatId} {
      allow read:   if isChuyenGia() || isAdmin();
      allow create, delete: if false;
      allow update: if isChuyenGia()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['trangThai', 'nguoiDuyet', 'duyetLuc'])
                    && request.resource.data.trangThai in ['cho', 'daDuyet', 'tuChoi'];
    }

    /* ── Thống kê theo dõi: chỉ hàm nền ghi ── */
    match /thong_ke_nguong/{thongKeId} {
      allow read:  if isChuyenGia() || isAdmin();
      allow write: if false;
    }

    /* ── Mặc định: cấm ── */
    match /{document=**} { allow read, write: if false; }
  }
}
