rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /* Nội dung học (bài + hình) để ở Hosting, không ở Storage.
       Storage chỉ dùng cho ảnh đại diện. */

    /* Storage KHÔNG đọc được Firestore, nên quyền sở hữu phải nằm ngay trong đường dẫn:
       avatars/{uid}/... — mỗi người chỉ ghi được vào thư mục mang uid của mình.
       Luật cũ chỉ hỏi "có đăng nhập không", nên bất kỳ ai cũng ghi đè được ảnh của
       mọi người khác. */
    match /avatars/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && userId == request.auth.uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && userId == request.auth.uid;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
